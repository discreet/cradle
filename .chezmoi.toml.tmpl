{{- /* Asked once on `chezmoi init`; answers are saved to ~/.config/chezmoi/chezmoi.toml. */ -}}
{{- $name := promptStringOnce . "name" "Full name" -}}
{{- $personalEmail := promptStringOnce . "personalEmail" "Personal git email (your GitHub noreply address keeps it private)" -}}
{{- $workEmail := promptStringOnce . "workEmail" "Work git email (leave blank if this machine has no work identity)" -}}
{{- $workHost := "" -}}
{{- $workOrgs := "" -}}
{{- $workFolders := "" -}}
{{- if $workEmail -}}
{{-   $workHost = promptStringOnce . "workHost" "Work git host such as gitlab.com or git.example.com" -}}
{{-   $workOrgs = promptStringOnce . "workOrgs" "Work orgs or groups exactly as in repo URLs (space-separated; blank if every repo on that host is work)" -}}
{{-   $workFolders = promptStringOnce . "workFolders" "Folders for Claude's work memory in or outside git (separated by semicolons; blank for none)" -}}
{{-   $folders := list -}}
{{-   range splitList ";" $workFolders -}}
{{-     $f := trim . | trimSuffix "/" -}}
{{-     if $f -}}{{ $folders = append $folders (regexReplaceAll "^~" $f $.chezmoi.homeDir) }}{{ end -}}
{{-   end -}}
{{-   $workFolders = join ";" $folders -}}
{{-   if not $workHost -}}
{{-     fail "A work email needs a work git host." -}}
{{-   end -}}
{{-   if and (eq $workHost "github.com") (not (trim $workOrgs)) -}}
{{-     fail "Personal repos are on github.com, so a github.com work identity needs its orgs." -}}
{{-   end -}}
{{- end -}}
{{- /* Obsidian: a structured work vault (daily notes, journal), asked only with a
       work identity, and an unstructured personal vault. The work vault was
       once the only one, "obsidianVault"; its answers carry over as defaults. */ -}}
{{- $workVault := "" -}}
{{- $workVaultPrivate := "" -}}
{{- if $workEmail -}}
{{-   $workVault = promptStringOnce . "workVault" "Work Obsidian vault folder for daily notes and the journal (leave blank for none)" (get . "obsidianVault" | default "") -}}
{{-   if $workVault -}}
{{-     $workVault = regexReplaceAll "^~" $workVault .chezmoi.homeDir | trimSuffix "/" -}}
{{-     $workVaultPrivate = promptStringOnce . "workVaultPrivate" "Work vault folders Claude must not read (separated by semicolons; blank for none)" (get . "obsidianPrivate" | default "") -}}
{{-   end -}}
{{- end -}}
{{- $personalVault := promptStringOnce . "personalVault" "Personal Obsidian vault folder (leave blank for none)" -}}
{{- $personalVaultPrivate := "" -}}
{{- if $personalVault -}}
{{-   $personalVault = regexReplaceAll "^~" $personalVault .chezmoi.homeDir | trimSuffix "/" -}}
{{-   $personalVaultPrivate = promptStringOnce . "personalVaultPrivate" "Personal vault folders Claude must not read (separated by semicolons; blank for none)" -}}
{{- end -}}

# Remembers where the repo was cloned, so later commands find it from anywhere.
sourceDir = {{ .chezmoi.sourceDir | quote }}

[data]
  name = {{ $name | quote }}
  personalEmail = {{ $personalEmail | quote }}
  workEmail = {{ $workEmail | quote }}
  workHost = {{ $workHost | quote }}
  workOrgs = {{ $workOrgs | quote }}
  workFolders = {{ $workFolders | quote }}
  workVault = {{ $workVault | quote }}
  workVaultPrivate = {{ $workVaultPrivate | quote }}
  personalVault = {{ $personalVault | quote }}
  personalVaultPrivate = {{ $personalVaultPrivate | quote }}

[edit]
  command = "nvim"
