#!/usr/bin/env bash
# Claude Code hook for the work vault's journal, run at SessionStart and on every
# prompt (UserPromptSubmit), so a session left open overnight gets the next
# morning's too. Once each, Claude says in one line what it's doing and does
# it without asking:
# - catches up the last weekday's Meetings or Slack summary, if missing (then
#   backs up the vaults). Those come from claude.ai connectors (Google
#   Calendar, Slack), which headless runs like the evening journal can't use;
# - on a weekday, adds today's meetings to today's daily note (as headings to
#   take notes under), if they aren't there yet.
# Each day is checked once, so later prompts return after two file tests. The
# evening run itself is left alone.
set -euo pipefail

vault={{ .workVault | quote }}
state="${XDG_STATE_HOME:-$HOME/.local/state}/cradle/journal"
read -r today weekday < <(date '+%F %u')
back=1 # to the last weekday: Monday -> Friday, Sunday -> Friday
((weekday == 1)) && back=3
((weekday == 7)) && back=2
day=$(date -v-${back}d +%F)
agenda=""
((weekday <= 5)) && [[ ! -e $state/agenda-checked-$today ]] && agenda=1
[[ -n $agenda || ! -e $state/checked-$day ]] || exit 0

IFS=$'\t' read -r event cwd < <(jq -r '[.hook_event_name // "SessionStart", .cwd // ""] | @tsv')
[[ $cwd != "$state" ]] || exit 0

folder=$(jq -r '.folder // ""' "$vault/.obsidian/daily-notes.json" 2>/dev/null || true)
note() { echo "$vault/${folder:+$folder/}$1.md"; }
# has <note> <section> <regex>: a line of that section matches the regex.
has() {
  [[ -f $1 ]] && awk -v head="^## ${2}[[:space:]]*\$" -v want="$3" '
    $0 ~ head { s = 1; next } /^## / { s = 0 } s && $0 ~ want { found = 1 }
    END { exit !found }' "$1"
}
tasks=()
mkdir -p "$state"

if [[ -n $agenda ]]; then
  touch "$state/agenda-checked-$today"
  has "$(note "$today")" Meetings '%% (agenda|journal) %%' ||
    tasks+=("add today's meetings ($today) to the daily note as headings to take notes under, with the journal skill's agenda mode")
fi
if [[ ! -e $state/checked-$day ]]; then
  touch "$state/checked-$day"
  missing=()
  has "$(note "$day")" Meetings '%% journal %%' || missing+=(Meetings)
  has "$(note "$day")" Slack '[^[:space:]]' || missing+=(Slack)
  if ((${#missing[@]})); then
    what=${missing[*]}
    tasks+=("catch up the ${what/ / and } summary for $day with the journal skill (the evening run can't reach claude.ai connectors)")
  fi
fi

((${#tasks[@]})) || exit 0
when="in your first reply"
[[ $event == SessionStart ]] || when="after handling the user's message"
text="Obsidian journal, $when, without asking: tell the user in one line what you're doing, then $(printf '%s; ' "${tasks[@]}")"
jq -n --arg event "$event" --arg text "${text%; }." \
  '{hookSpecificOutput: {hookEventName: $event, additionalContext: $text}}'
