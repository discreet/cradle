#!/usr/bin/env bash
# Prints what happened at work on a day, for the journal skill: each work
# Claude Code session (its folder, the user's prompts and Claude's replies,
# shortened) and the user's commits in the work git repos under the home
# folder. is-work decides what's work; personal activity is left out.
# Usage: journal-data [YYYY-MM-DD]  (default: today). Exits 2, after
# is-work's message, when macOS denies access to a work folder, and 1 when jq
# is missing or fails, so a broken run isn't mistaken for a quiet day.
set -euo pipefail

command -v jq >/dev/null || { echo "journal-data: jq not found" >&2; exit 1; }

day=${1:-$(date +%F)}
from=$(date -j -f '%Y-%m-%d %H:%M:%S' "$day 00:00:00" +%s)
to=$(date -j -v+1d -f '%Y-%m-%d %H:%M:%S' "$day 00:00:00" +%s)
start=$(date -u -r "$from" +%Y-%m-%dT%H:%M:%SZ)
end=$(date -u -r "$to" +%Y-%m-%dT%H:%M:%SZ)
# obsidian-journal runs this outside mise, which sets CLAUDE_CONFIG_DIR.
projects="${CLAUDE_CONFIG_DIR:-$HOME/.config/claude}/projects"
# The evening run works from here; its own session isn't part of the day.
is_work="$(dirname "$0")/is-work"
skip="${XDG_STATE_HOME:-$HOME/.local/state}/cradle/journal"

echo "# Claude Code sessions on $day"
cwds=()
while IFS= read -r f; do
  [[ -r $f ]] || continue # removed since find listed it
  # Line by line (-R, fromjson?), so a malformed line, like one cut off
  # mid-write, is skipped alone; any other jq failure stops the run. The
  # folder is taken before descending into a reply, whose parts have no cwd.
  lines=$(jq -rR --arg s "$start" --arg e "$end" --arg skip "$skip" '
    fromjson? | objects |
    select(.timestamp? and .timestamp >= $s and .timestamp < $e and .cwd != $skip) |
    .cwd as $c |
    if .type == "user" and (.message.content? | type) == "string"
      and (.message.content | startswith("<") | not) then
      "\($c)\tuser: \(.message.content[:400] | gsub("\\s+"; " "))"
    elif .type == "assistant" then
      .message.content[]? | select(.type? == "text" and (.text | type) == "string") |
      "\($c)\tclaude: \(.text[:400] | gsub("\\s+"; " "))"
    else empty end' "$f") || { echo "journal-data: jq failed on $f" >&2; exit 1; }
  [[ -n $lines ]] || continue
  cwd=$(head -n1 <<<"$lines" | cut -f1)
  "$is_work" "$cwd" || { (($? == 2)) && exit 2; continue; }
  cwds+=("$cwd")
  echo
  echo "## ${cwd/#$HOME/\~}"
  cut -f2- <<<"$lines"
done < <(find "$projects" -name '*.jsonl' -not -path '*/subagents/*' -newermt "$day 00:00:00" 2>/dev/null)

echo
echo "# Commits on $day"
{
  find "$HOME" -maxdepth 4 \( -name Library -o -name .Trash -o -name node_modules \
    -o -name .cache -o -name .local \) -prune -o -name .git -print 2>/dev/null |
    sed 's#/\.git$##' || true # find fails on folders macOS never lets it read (Photos, TV)
  for cwd in "${cwds[@]}"; do git -C "$cwd" rev-parse --show-toplevel 2>/dev/null || true; done
} | sort -u | while IFS= read -r repo; do
  "$is_work" "$repo" || { (($? == 2)) && exit 2; continue; }
  [[ -d $repo/.obsidian ]] && continue # a vault's own backup commits
  email=$(git -C "$repo" config user.email 2>/dev/null) || continue
  log=$(git -C "$repo" log --all --since="$start" --until="$end" --author="$email" \
    --format='%h %s' 2>/dev/null) || continue
  [[ -n $log ]] || continue
  echo
  echo "## ${repo/#$HOME/\~}"
  echo "$log"
done
