#!/usr/bin/env bash
# Claude Code's agentdb MCP server (registered by run_onchange_after_45-claude-mcp).
# Work and personal memories stay apart. Claude Code starts this in the
# session's folder, which is work when git's identity there is the work one
# (set by the repo's remote, see ~/.config/git/config) or when it's inside one
# of the work folders given to chezmoi; then it uses work.db, else personal.db.
set -euo pipefail

db=personal
work={{ .workEmail | quote }}
work_folders=({{ range splitList ";" .workFolders }}{{ if . }}{{ quote . }} {{ end }}{{ end }})
here=$(pwd -P)
if [[ -n $work && $(git config user.email 2>/dev/null) == "$work" ]]; then
  db=work
fi
for f in "${work_folders[@]}"; do
  f=$(cd "$f" 2>/dev/null && pwd -P) || continue
  if [[ $here == "$f" || $here == "$f"/* ]]; then db=work; fi
done
AGENTDB_PATH="$HOME/.local/share/agentdb/$db.db" exec agentdb mcp start
