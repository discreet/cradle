#!/usr/bin/env bash
# Run every evening at 18:00 by the local.obsidian-journal LaunchAgent (with
# Homebrew's bash, which needs Full Disk Access to read ~/Documents): if
# anything happened at work today, Claude writes the day's summary into today's
# the backup includes the summary. Log: ~/Library/Logs/obsidian-journal.log.
# Without access to the work folders it says so here and leaves a marker
# (no-access) that journal-check reports in the next Claude Code session.
set -euo pipefail

# launchd's PATH is minimal: mise's shims (claude), ~/.local/bin, Apple's git,
# and Homebrew's bash for the scripts this runs.
PATH="${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims:$HOME/.local/bin:/Library/Developer/CommandLineTools/usr/bin:/opt/homebrew/bin:/usr/bin:/bin"
# journal-data leaves out sessions in this folder, so this run isn't journaled.
dir="${XDG_STATE_HOME:-$HOME/.local/state}/cradle/journal"
mkdir -p "$dir"
echo "== $(date)"

data=$(journal-data) && status=0 || status=$?
if ((status == 2)); then
  bash=$(realpath "$BASH")
  echo "No access to the work folders in ~/Documents: grant Full Disk Access to $bash" \
    "(System Settings > Privacy & Security > Full Disk Access). Nothing was journaled."
  echo "$(date +%F) $bash" >"$dir/no-access"
elif ((status != 0)); then
  echo "journal-data failed ($status)."
elif grep -q '^## ' <<<"$data"; then
  rm -f "$dir/no-access"
  # Read-only tools only: Slack (under the connector's name or the Slack
  # plugin's; a session has one or the other), Google Calendar, Drive and
  for t in search_public_and_private read_thread read_user_profile; do
    tools+=("mcp__claude_ai_Slack__slack_$t" "mcp__plugin_slack_slack__slack_$t")
  done
  for t in list_calendars list_events get_event search_events; do
    tools+=("mcp__claude_ai_Google_Calendar__$t")
  done
  tools+=(mcp__claude_ai_Google_Drive__get_file_metadata mcp__claude_ai_Google_Drive__read_file_content
    mcp__claude_ai_Google_Docs__read_doc)
  done
  (cd "$dir" && claude -p "Use the journal skill to write today's summary into my work Obsidian daily note. Don't run vault-sync; this run backs up the vaults after you." \
    --permission-mode acceptEdits --allowedTools "${tools[@]}") || echo "The journal run failed."
else
  rm -f "$dir/no-access"
  echo "Nothing happened today."
fi
# Back up the vaults once today's note is written (installed with a vault repo).
if command -v vault-sync >/dev/null; then vault-sync; fi
