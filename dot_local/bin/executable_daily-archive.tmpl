#!/usr/bin/env bash
# Archives the work vault's past daily notes, so only today's stays at the
# top of the daily notes folder: each <folder>/YYYY-MM-DD.md dated before
# today moves to <folder>/YYYY-MM MMMM/Week N/ (e.g. "2026-11 November/Week 4";
# days 1-7 are Week 1, 8-14 Week 2, 15-21 Week 3, 22 to the month's end
# Week 4). Run every morning at 04:00 by the local.daily-archive LaunchAgent
# (with Homebrew's bash, which needs Full Disk Access to read ~/Documents) and
# at the start of the journal skill's agenda mode. Touches only files named
# like a date, never overwrites or deletes: a note whose archive path is
# taken stays where it is and is reported (exit 1). When it moved anything,
# vault-sync backs up the vaults. Log: ~/Library/Logs/daily-archive.log.
# daily-archive --path YYYY-MM-DD prints where that day's note is: in the
# archive, else at the top; one that doesn't exist yet belongs at the top for
# today or later and in the archive for an earlier day.
set -euo pipefail

# launchd's PATH is minimal; jq is macOS's own.
PATH="/usr/bin:/bin:$PATH"
vault={{ .workVault | quote }}
folder=$(jq -r '.folder // ""' "$vault/.obsidian/daily-notes.json" 2>/dev/null || true)
daily=$vault${folder:+/$folder}
today=$(date +%F)

valid() { # a real date, YYYY-MM-DD
  [[ $1 =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ && $(date -j -f %F "$1" +%F 2>/dev/null) == "$1" ]]
}
archived() { # archived <YYYY-MM-DD>: that day's note in the archive
  local day=$((10#${1:8:2}))
  local week=$(((day + 6) / 7))
  ((week <= 4)) || week=4
  echo "$daily/$(LC_ALL=C date -j -f %F "$1" '+%Y-%m %B')/Week $week/$1.md"
}

if [[ ${1:-} == --path ]]; then
  valid "${2:-}" || { echo "usage: daily-archive [--path YYYY-MM-DD]" >&2; exit 64; }
  to=$(archived "$2")
  if [[ -e $to ]]; then
    echo "$to"
  elif [[ -e $daily/$2.md || ! $2 < $today ]]; then
    echo "$daily/$2.md"
  else
    echo "$to"
  fi
  exit 0
fi
(($# == 0)) || { echo "usage: daily-archive [--path YYYY-MM-DD]" >&2; exit 64; }

echo "== $(date)"
if ! ls "$daily" >/dev/null 2>&1; then
  [[ -e $daily ]] || exit 0 # no daily notes yet
  echo "No access to $daily: grant Full Disk Access to $(realpath "$BASH")" \
    "(System Settings > Privacy & Security > Full Disk Access). Nothing was archived." >&2
  exit 2
fi
moved=0 status=0
for f in "$daily"/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9].md; do
  [[ -f $f ]] || continue
  day=$(basename "$f" .md)
  valid "$day" && [[ $day < $today ]] || continue
  to=$(archived "$day")
  if [[ ! -e $to ]]; then
    mkdir -p "${to%/*}"
    mv -n "$f" "$to" || true # -n: never replaces one that appeared meanwhile
  fi
  if [[ -e $f ]]; then
    echo "Skipped ${f#"$vault"/}: ${to#"$vault"/} already exists; merge them by hand." >&2
    status=1
  else
    echo "Moved ${f#"$vault"/} to ${to#"$vault"/}"
    moved=1
  fi
done
sync=$(dirname "$0")/vault-sync
if ((moved)) && [[ -x $sync ]]; then "$sync" || status=1; fi
exit "$status"
