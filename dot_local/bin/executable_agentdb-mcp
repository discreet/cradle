#!/usr/bin/env bash
# Claude Code's agentdb MCP server (registered by run_onchange_after_45-claude-mcp).
# Work and personal memories stay apart. Claude Code starts this in the
# session's folder; is-work decides whether that's work (work.db) or
# personal (personal.db). `agentdb-mcp work` or `agentdb-mcp personal` picks
# the database outright: cradle reads both (agentdb-work in its folder, both
# in the cradle-maintainer agent).
set -euo pipefail

case ${1:-} in
  work | personal) db=$1 ;;
  "")
    db=personal
    if "$(dirname "$0")/is-work"; then db=work; fi
    ;;
  *) echo "usage: agentdb-mcp [work|personal]" >&2; exit 64 ;;
esac
AGENTDB_PATH="$HOME/.local/share/agentdb/$db.db" exec agentdb mcp start
