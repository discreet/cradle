{{- /* chezmoi:modify-template */ -}}
{{- /*
  Claude Code also writes this file (/config, /model, /statusline, plugin
  installs). Merge the keys declared in .chezmoitemplates/claude-settings.json
  over whatever is live, so declared values win and runtime additions survive.
*/ -}}
{{- $live := dict -}}
{{- if .chezmoi.stdin | trim -}}
{{-   $live = .chezmoi.stdin | fromJson -}}
{{- end -}}
{{- $managed := includeTemplate "claude-settings.json" . | fromJson -}}
{{- /*
  The Obsidian vault is a working folder in every session; Claude's file
  tools can't read or edit the folders named as private; and each session
  starts, and each prompt, checks for today's agenda and missing Meetings or
  Slack summaries (journal-check; once a day, so later prompts cost nothing).
*/ -}}
{{- if .obsidianVault -}}
{{-   $_ := set $managed.permissions "additionalDirectories" (list .obsidianVault) -}}
{{-   $check := dict "type" "command" "command" (joinPath .chezmoi.homeDir ".local/bin/journal-check") -}}
{{-   $on := list (dict "hooks" (list $check)) -}}
{{-   $_ := set $managed "hooks" (dict "SessionStart" $on "UserPromptSubmit" $on) -}}
{{-   $deny := list -}}
{{-   range splitList ";" .obsidianPrivate -}}
{{-     $folder := trim . | trimSuffix "/" -}}
{{-     if $folder -}}
{{-       $path := printf "/%s/%s/**" $.obsidianVault $folder -}}
{{-       $deny = concat $deny (list (printf "Read(%s)" $path) (printf "Edit(%s)" $path)) -}}
{{-     end -}}
{{-   end -}}
{{-   if $deny -}}
{{-     $_ := set $managed.permissions "deny" $deny -}}
{{-   end -}}
{{- end -}}
{{- mergeOverwrite $live $managed | toPrettyJson "  " }}
