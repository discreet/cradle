{{- /* chezmoi:modify-template */ -}}
{{- /*
  Claude Code also writes this file (/config, /model, /statusline, plugin
  installs). Merge the keys declared in .chezmoitemplates/claude-settings.json
  over whatever is live, so declared values win and runtime additions survive.
*/ -}}
{{- $live := dict -}}
{{- if .chezmoi.stdin | trim -}}
{{-   $live = .chezmoi.stdin | fromJson -}}
{{- end -}}
{{- $managed := includeTemplate "claude-settings.json" . | fromJson -}}
{{- /*
  Both Obsidian vaults are working folders in every session; Claude's file
  tools can't read or edit the folders named as private in either (added to
  work vault, each session start and each prompt checks for today's agenda
  and missing Meetings or Slack summaries (journal-check; once a day, so
  later prompts cost nothing).
*/ -}}
{{- $vaults := list -}}
{{- $deny := list -}}
{{- range list (list .workVault .workVaultPrivate) (list .personalVault .personalVaultPrivate) -}}
{{-   $vault := index . 0 -}}
{{-   if $vault -}}
{{-     $vaults = append $vaults $vault -}}
{{-     range splitList ";" (index . 1) -}}
{{-       $folder := trim . | trimSuffix "/" -}}
{{-       if $folder -}}
{{-         $path := printf "/%s/%s/**" $vault $folder -}}
{{-         $deny = concat $deny (list (printf "Read(%s)" $path) (printf "Edit(%s)" $path)) -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- if $vaults -}}
{{-   $_ := set $managed.permissions "additionalDirectories" $vaults -}}
{{- end -}}
{{- if $deny -}}
{{-   $_ := set $managed.permissions "deny" (concat $managed.permissions.deny $deny) -}}
{{- end -}}
{{- /* vault-sync runs without asking (the journal runs it), added to the user's own allow list. */ -}}
{{- if or .workVaultRepo .personalVaultRepo -}}
{{-   $allow := list -}}
{{-   if hasKey $live "permissions" -}}
{{-     $allow = get $live.permissions "allow" | default list -}}
{{-   end -}}
{{-   $_ := set $managed.permissions "allow" (append $allow "Bash(vault-sync)" | uniq) -}}
{{- end -}}
{{- $hooks := dict -}}
{{- if .workVault -}}
{{-   $check := dict "type" "command" "command" (joinPath .chezmoi.homeDir ".local/bin/journal-check") -}}
{{-   $on := list (dict "hooks" (list $check)) -}}
{{-   $hooks = dict "SessionStart" $on "UserPromptSubmit" $on -}}
{{- end -}}
{{- /* Every machine: starting, resuming or clearing a session shows the user its custom agents. */ -}}
{{- $agents := dict "type" "command" "command" (joinPath .chezmoi.homeDir ".local/bin/claude-agents") -}}
{{- $_ := set $hooks "SessionStart" (append (get $hooks "SessionStart" | default list) (dict "matcher" "startup|resume|clear" "hooks" (list $agents))) -}}
{{- /*
  Rex machines: Rex's own hook, as `rex skill setup` writes it, so Rex can
  tell which session Claude runs in. rex is on PATH only in Rex's terminals.
*/ -}}
{{- if eq .terminal "rex" -}}
{{-   $rex := dict "type" "command" "command" "/bin/sh -c 'rex __internal session-start --agent claude 2>/dev/null || true'" "timeout" 5 -}}
{{-   $_ := set $hooks "SessionStart" (append (get $hooks "SessionStart" | default list) (dict "hooks" (list $rex))) -}}
{{- end -}}
{{- $_ := set $managed "hooks" $hooks -}}
{{- mergeOverwrite $live $managed | toPrettyJson "  " }}
