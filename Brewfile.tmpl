# Only what mise can't install: the login shell, its completion framework,
# mise itself, and GUI apps. A chezmoi template, so the terminal app follows
# this machine's answer; run_onchange_before_10-brew-bundle.sh.tmpl renders
# it and re-runs whenever the rendered file changes.
#
# CLI tools live in ~/.config/mise/config.toml. git comes from the Command
# Line Tools.

# Shell
brew "bash"
brew "bash-completion@2"

# Tool versions
brew "mise"

# Apps
{{- if eq .terminal "ghostty" }}
cask "ghostty"
{{- end }}
cask "obsidian"
