{{ if .obsidianVault -}}
#!/usr/bin/env bash
# Applies obsidian/ from this repo to the vault: the Daily notes and Templates
# settings are merged into Obsidian's own files (other settings changed in
# Obsidian stay), and the daily note template is written. Re-runs when they
# change; Obsidian reads its settings when it next opens the vault.
# daily-notes.json: {{ include "obsidian/daily-notes.json" | sha256sum }}
# templates.json: {{ include "obsidian/templates.json" | sha256sum }}
# Templates/Daily.md: {{ include "obsidian/Templates/Daily.md" | sha256sum }}
set -euo pipefail

vault={{ .obsidianVault | quote }}
src={{ joinPath .chezmoi.sourceDir "obsidian" | quote }}
if [[ ! -d $vault/.obsidian ]]; then
  echo "No Obsidian vault at $vault yet; open it in Obsidian, then chezmoi apply."
  exit 0
fi

for f in daily-notes.json templates.json; do
  live="$vault/.obsidian/$f"
  [[ -s $live ]] || echo '{}' >"$live"
  jq -s '.[0] * .[1]' "$live" "$src/$f" >"$live.new"
  mv "$live.new" "$live"
done
mkdir -p "$vault/Templates" "$vault/$(jq -r .folder "$src/daily-notes.json")"
cp "$src/Templates/Daily.md" "$vault/Templates/Daily.md"
{{ end -}}
