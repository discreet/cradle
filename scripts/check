refuses() { # refuses <expected message> <command...>: fails, saying that
  local out
  if out=$("${@:2}" 2>&1); then echo "it didn't refuse"; return 1; fi
  grep -qF "$1" <<<"$out" || { echo "$out"; return 1; }
}
