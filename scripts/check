init_answers() { # renders .chezmoi.toml.tmpl with a full set of answers
  cz_new execute-template --init \
  --promptString "Full name=Check,Personal git email (your GitHub noreply address keeps it private)=personal@example.com,Work git email (leave blank if this machine has no work identity)=work@example.com,Work git host such as gitlab.com or git.example.com=gitlab.com,Work orgs or groups exactly as in repo URLs (space-separated; blank if every repo on that host is work)=,Folders for Claude's work memory in or outside git (separated by semicolons; blank for none)=~/work; ~/clients b/,Work Obsidian vault folder for daily notes and the journal (leave blank for none)=~/Work Notes/,Work vault folders Claude must not read (separated by semicolons; blank for none)=HR,Personal Obsidian vault folder (leave blank for none)=~/Notes,Personal vault folders Claude must not read (separated by semicolons; blank for none)=,Private git repo on the work host to back up the work vault to (SSH URL; blank for none)=git@example.com:org/notes.git,Private git repo to back up the personal vault to (SSH URL; blank for none)=" \
  <"$repo/.chezmoi.toml.tmpl"
}
