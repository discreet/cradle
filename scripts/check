#!/usr/bin/env bash
# Checks the repo without touching this Mac: renders every dotfile into a
# throwaway home folder and runs each one through the tool that reads it.
# Run before `chezmoi apply`; exits non-zero if anything fails.
# The helper functions run through `check`, which shellcheck can't see, and
# the `~` paths below are literal: they're what git and ssh report.
# shellcheck disable=SC2329,SC2088
set -uo pipefail

repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
tmp=$(mktemp -d)
home=$tmp/home
mkdir -p "$home"
# Claude runs inside tmux, so the test server must ignore $TMUX or it would
# reach the real one.
t() { env -u TMUX TMUX_TMPDIR="$tmp" tmux -L check "$@"; }
trap 't kill-server 2>/dev/null; rm -rf "$tmp"' EXIT
failed=0

check() { # check <description> <command...>
  local out
  if out=$("${@:2}" 2>&1); then
    echo "ok    $1"
  else
    echo "FAIL  $1"
    while IFS= read -r line; do echo "      $line"; done <<<"$out"
    failed=1
  fi
}
skip() { echo "skip  $1"; }
have() { command -v "$1" >/dev/null; }

# Rendered three times: work on github.com beside personal, under two orgs,
# with both Obsidian vaults (most checks use this one); work on its own host,
# with no vaults; and no work identity, with only a personal vault.
setup() { # setup <name> <work email> <work host> <work orgs> [work vault] [its private folders] [work folders] [personal vault] [its private folders] [work vault repo] [personal vault repo]
  mkdir -p "$tmp/$1"
  cat >"$tmp/$1.toml" <<EOF
sourceDir = "$repo"
[data]
  name = "Check"
  personalEmail = "personal@example.com"
  workEmail = "$2"
  workHost = "$3"
  workOrgs = "$4"
  workVault = "${5:-}"
  workVaultPrivate = "${6:-}"
  workFolders = "${7:-}"
  personalVault = "${8:-}"
  personalVaultPrivate = "${9:-}"
  workVaultRepo = "${10:-}"
  personalVaultRepo = "${11:-}"
EOF
}
vault=$tmp/vault pvault=$tmp/personal-vault remotes=$tmp/remotes
setup home work@example.com github.com "Example-Org other-org" "$vault" "Team Stuff; Private/HR/" \
  "$tmp/work;$tmp/clients b" "$pvault" "Diary/" "$remotes/work.git" "$remotes/personal.git"
setup home-selfhosted work@example.com git.example.com ""
setup home-personal "" "" "" "" "" "" "$pvault" "" "" "$remotes/personal.git"
home2=$tmp/home-personal
home3=$tmp/home-selfhosted
czh() { # czh <name> <chezmoi args...>
  HOME=$tmp/$1 chezmoi --config "$tmp/$1.toml" --persistent-state "$tmp/$1.boltdb" "${@:2}"
}
cz() { czh home "$@"; }
# A machine chezmoi hasn't seen, so the init questions take the answers given.
cz_new() { HOME=$tmp/new chezmoi --config "$tmp/new.toml" --persistent-state "$tmp/new.boltdb" "$@"; }
mkdir -p "$tmp/new"
toml() { cz execute-template "{{ include \"$1\" | fromToml | len }}" >/dev/null; }

# Shell files source each other at runtime, which shellcheck can't follow.
sc() { shellcheck -s bash -e SC1090,SC1091 "$@"; }
sc_script() {
  if [[ $1 == *.tmpl ]]; then
    cz execute-template <"$1" | sc -
  else
    sc "$1"
  fi
}
inputrc() {
  local out
  out=$(INPUTRC=/dev/null bash --norc --noprofile -i -c "bind -f '$1'" 2>&1 |
    grep -v -e 'terminal process group' -e 'no job control')
  [[ -z $out ]] || { echo "$out"; return 1; }
  # Readline silently ignores unknown function names, so look those up too.
  local fns fn
  fns=$(bash --norc --noprofile -i -c 'bind -l' 2>/dev/null)
  while read -r fn; do
    grep -qxF "$fn" <<<"$fns" || { echo "unknown readline function: $fn"; return 1; }
  done < <(sed -nE 's/^[^#]*:[[:space:]]*([a-z-]+)[[:space:]]*$/\1/p' "$1")
}
lua_syntax() {
  nvim --clean --headless -c "lua for _, f in ipairs(vim.fn.globpath('$1', '**/*.lua', false, true)) do
      local ok, err = loadfile(f)
      if not ok then io.stderr:write(err .. '\n'); vim.cmd('cquit') end
    end" -c qall
}
identity() { # identity <home> <remote url> <email> <signing key> [rewritten url]
  local dir=$tmp/identity got
  rm -rf "$dir"
  git init -q "$dir"
  git -C "$dir" remote add origin "$2"
  g() { HOME=$1 XDG_CONFIG_HOME=$1/.config git -C "$dir" "${@:2}"; }
  got="$(g "$1" config user.email) $(g "$1" config user.signingkey) $(g "$1" ls-remote --get-url origin)"
  [[ $got == "$3 $4 ${5:-$2}" ]] || { echo "expected: $3 $4 ${5:-$2}"; echo "got:      $got"; return 1; }
}
agentdb_db() { # agentdb_db <home> <folder> <remote url, or "" for no repo> <expected database>
  local bin=$tmp/agentdb-bin got
  mkdir -p "$bin" "$2"
  # shellcheck disable=SC2016 # a fake agentdb that prints the database it's given
  printf '#!/bin/sh\necho "$AGENTDB_PATH"\n' >"$bin/agentdb" && chmod +x "$bin/agentdb"
  if [[ -n $3 ]]; then git init -q "$2" && git -C "$2" remote add origin "$3"; fi
  got=$(cd "$2" && HOME=$1 XDG_CONFIG_HOME=$1/.config PATH=$bin:$PATH "$1/.local/bin/agentdb-mcp")
  [[ $got == "$1/.local/share/agentdb/$4.db" ]] || { echo "expected $4.db, got: $got"; return 1; }
}
ssh_key() { # ssh_key <ssh config> <host> <the only key ssh should offer>
  local got
  got=$(ssh -G -F "$1" "$2" | sed -n 's/^identityfile //p')
  [[ $got == "$3" ]] || { echo "expected $3, got: $got"; return 1; }
}
ssh_only() { # ssh_only <ssh config> <host>: keys in the agent aren't offered
  ssh -G -F "$1" "$2" | grep -qx 'identitiesonly yes' || { echo "IdentitiesOnly is off for $2"; return 1; }
}
brew_env() { # 00-homebrew.bash sets what `brew shellenv` sets: brew_env <MANPATH or "">
  local show='env | grep -E "^(HOMEBREW_[A-Z]+|PATH|MANPATH|INFOPATH)=" | sort' want got
  want=$(env -i HOME="$tmp" PATH=/usr/bin:/bin ${1:+MANPATH=$1} bash --norc --noprofile -c "eval \"\$(/opt/homebrew/bin/brew shellenv)\"; $show")
  got=$(env -i HOME="$tmp" PATH=/usr/bin:/bin ${1:+MANPATH=$1} bash --norc --noprofile -c "source \"\$1\"; $show" _ "$home/.config/bash/rc.d/00-homebrew.bash")
  [[ $got == "$want" ]] || { diff <(echo "$want") <(echo "$got"); return 1; }
}
claude_merge() { # managed Claude settings merge over a live file and keep its keys
  local live=$tmp/merge/.config/claude/settings.json out
  mkdir -p "${live%/*}"
  echo '{"model":"opus","theme":"dark","permissions":{"allow":["Bash(ls *)"]}}' >"$live"
  out=$(HOME=$tmp/merge chezmoi --config "$tmp/home.toml" --persistent-state "$tmp/merge.boltdb" cat "$live") || return 1
  jq -e '.model == "opus" and .theme == "auto" and .permissions.allow == ["Bash(ls *)", "Bash(vault-sync)"]
    and (.permissions.ask | length > 0)' <<<"$out" >/dev/null || { echo "$out"; return 1; }
}
obsidian_settings() {
  jq -e --arg v "$vault" --arg p "$pvault" '.permissions.additionalDirectories == [$v, $p]
    and (.permissions.deny | index("Read(/\($v)/Team Stuff/**)") != null)
    and (.permissions.deny | index("Edit(/\($v)/Private/HR/**)") != null)
    and (.permissions.deny | index("Read(/\($p)/Diary/**)") != null)
    and ([[.hooks.SessionStart, .hooks.UserPromptSubmit][][0].hooks[0].command | endswith("/journal-check")] | all)' \
    "$home/.config/claude/settings.json" >/dev/null ||
    { jq .permissions "$home/.config/claude/settings.json"; return 1; }
}
obsidian_instructions() {
  local f=$home/.config/claude/CLAUDE.md
  local want
  for want in "Work: \`$vault\`" "Personal: \`$pvault\`" "is-work" "- \`$vault/Team Stuff\`" \
    "- \`$vault/Private/HR\`" "- \`$pvault/Diary\`"; do
    grep -qF -- "$want" "$f" || { echo "missing: $want"; cat "$f"; return 1; }
  done
}
personal_vault_only() { # no journal, hooks or daily notes; the vault is still Claude's
  local h=$tmp/home-personal f bad=0
  for f in .config/claude/skills/journal .local/bin/journal-data .local/bin/obsidian-journal \
    .local/bin/journal-check \
    Library/LaunchAgents/local.obsidian-journal.plist; do
    [[ ! -e $h/$f ]] || { echo "installed without a work vault: $f"; bad=1; }
  done
  for f in .local/bin/vault-sync Library/LaunchAgents/local.vault-sync.plist; do
    [[ -e $h/$f ]] || { echo "not installed with a personal vault repo: $f"; bad=1; }
  done
  grep -qF "personal Obsidian vault is \`$pvault\`" "$h/.config/claude/CLAUDE.md" || { echo "CLAUDE.md doesn't name the vault"; bad=1; }
  ! grep -qe 'journal. skill' -e 'Daily notes' "$h/.config/claude/CLAUDE.md" || { echo "CLAUDE.md mentions the journal"; bad=1; }
  jq -e --arg p "$pvault" '.permissions.additionalDirectories == [$p] and .hooks == null and .permissions.deny == null
    and .permissions.allow == ["Bash(vault-sync)"]' \
    "$h/.config/claude/settings.json" >/dev/null || { echo "settings: wrong vault access or hooks"; bad=1; }
  return "$bad"
}
no_obsidian() {
  local h=$tmp/home-selfhosted bad=0 f
  for f in .local/bin/journal-data .local/bin/vault-sync Library/LaunchAgents/local.vault-sync.plist; do
    [[ ! -e $h/$f ]] || { echo "installed without a vault: $f"; bad=1; }
  done
  ! grep -q Obsidian "$h/.config/claude/CLAUDE.md" || { echo "CLAUDE.md mentions Obsidian"; bad=1; }
  jq -e '.permissions.additionalDirectories == null and .hooks == null' \
    "$h/.config/claude/settings.json" >/dev/null || { echo "settings add a vault or hooks"; bad=1; }
  return "$bad"
}
is_work() { # git identity or work folder; anything else, or no work identity, is personal
  local w=$tmp/is-work bad=0
  mkdir -p "$w/job" "$w/mine" "$tmp/work/notes"
  git -C "$w/job" init -q && git -C "$w/job" config user.email work@example.com
  git -C "$w/mine" init -q && git -C "$w/mine" config user.email personal@example.com
  "$home/.local/bin/is-work" "$w/job" || { echo "work repo not work"; bad=1; }
  "$home/.local/bin/is-work" "$tmp/work/notes" || { echo "work folder not work"; bad=1; }
  ! "$home/.local/bin/is-work" "$w/mine" || { echo "personal repo is work"; bad=1; }
  ! "$home/.local/bin/is-work" "$w" || { echo "plain folder is work"; bad=1; }
  ! "$home2/.local/bin/is-work" "$tmp/work/notes" || { echo "work without a work identity"; bad=1; }
  return "$bad"
}
obsidian_apply() { # merges into existing settings, writes the template; nothing without a vault
  mkdir -p "$vault/.obsidian"
  echo '{"autorun":true,"folder":"Old"}' >"$vault/.obsidian/daily-notes.json"
  cz execute-template <"$repo/run_onchange_after_35-obsidian.sh.tmpl" | bash >/dev/null || return 1
  jq -e '. == {"autorun":true,"folder":"Daily","format":"YYYY-MM-DD","template":"Templates/Daily"}' \
    "$vault/.obsidian/daily-notes.json" >/dev/null || { cat "$vault/.obsidian/daily-notes.json"; return 1; }
  jq -e '.folder == "Templates"' "$vault/.obsidian/templates.json" >/dev/null || return 1
  cmp "$repo/obsidian/Templates/Daily.md" "$vault/Templates/Daily.md" || return 1
  cmp "$repo/obsidian/Templates/Meeting.md" "$vault/Templates/Meeting.md" || return 1
  [[ -d $vault/Daily ]] || { echo "no Daily folder"; return 1; }
  [[ -z $(czh home-personal execute-template <"$repo/run_onchange_after_35-obsidian.sh.tmpl" | tr -d '[:space:]') ]] ||
    { echo "the script isn't empty without a vault"; return 1; }
}
journal_check() { # catches up the last weekday's missing summaries and adds today's agenda, once each
  local hook=$home/.local/bin/journal-check st=$tmp/journal-state day today note old out weekday=""
  today=$(date +%F)
  (($(date +%u) <= 5)) && weekday=1
  day=$(date -v-1d +%F)
  while (($(date -j -f %F "$day" +%u) > 5)); do day=$(date -j -v-1d -f %F "$day" +%F); done
  mkdir -p "$vault/.obsidian" "$vault/Daily"
  echo '{"folder":"Daily"}' >"$vault/.obsidian/daily-notes.json"
  note=$vault/Daily/$today.md old=$vault/Daily/$day.md
  rm -f "$note" "$old"
  run() { echo "{\"cwd\":\"$1\"}" | XDG_STATE_HOME=$st "$hook"; }
  says() { # says <text that must be in the offer>... ; then -- <text that must not>...
    local c
    c=$(run /somewhere | jq -r .hookSpecificOutput.additionalContext) || return 1
    while (($#)) && [[ $1 != -- ]]; do [[ $c == *"$1"* ]] || { echo "missing '$1': $c"; return 1; }; shift; done
    shift || true
    while (($#)); do [[ $c != *"$1"* ]] || { echo "shouldn't say '$1': $c"; return 1; }; shift; done
    rm -rf "$st"
  }
  printf '## Meetings\n\n## Terminal\n- did things\n\n## Slack\n\n' >"$old"
  if [[ -n $weekday ]]; then
    says "add today's meetings ($today)" "Meetings and Slack summary for $day" "without asking" -- "offer" || return 1
    printf '## Meetings\n### 09:00 Standup\n%%%% agenda %%%%\n' >"$note"
  fi
  says "catch up the Meetings and Slack summary" "without asking" -- "today's meetings" "offer" || return 1
  printf '## Meetings\n### 10:00 Sync\n- my notes\n\n## Slack  \n- #team: agreed on X\n' >"$old"
  says "Meetings summary" -- "Slack" || return 1
  printf '## Meetings\n### 10:00 Sync\n%%%% journal %%%%\n\n## Slack\n\n' >"$old"
  says "Slack summary" -- "Meetings" || return 1
  printf '## Meetings\n- Nothing.\n%%%% journal %%%%\n## Slack\n- Nothing.\n' >"$old"
  [[ -z $(run /somewhere) ]] || { echo "asked although everything is filled in"; return 1; }
  rm -rf "$st"; rm -f "$note"
  printf '## Slack\n' >"$old"
  [[ -n $(run /somewhere) ]] || { echo "no offer"; return 1; }
  [[ -z $(run /somewhere) ]] || { echo "asked twice"; return 1; }
  rm -rf "$st"
  [[ -z $(run "$st/cradle/journal") ]] || { echo "asked in the evening run"; return 1; }
  rm -rf "$st"
  out=$(echo '{"hook_event_name":"UserPromptSubmit","cwd":"/x"}' | XDG_STATE_HOME=$st "$hook")
  jq -e '.hookSpecificOutput | .hookEventName == "UserPromptSubmit"
    and (.additionalContext | contains("after handling"))' <<<"$out" >/dev/null ||
    { echo "no offer on a prompt: $out"; return 1; }
  [[ -z $(echo '{"hook_event_name":"UserPromptSubmit"}' | XDG_STATE_HOME=$st "$hook") ]] ||
    { echo "asked again on the next prompt"; return 1; }
}
journal_data() { # today's work sessions and commits only, without the evening run's own
  local j=$tmp/journal today now yesterday out
  today=$(date +%F)
  now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  yesterday=$(date -u -v-1d +%Y-%m-%dT%H:%M:%SZ)
  mkdir -p "$j/claude/projects/p" "$j/home/code/app" "$j/home/code/mine"
  {
    echo "{\"type\":\"user\",\"timestamp\":\"$now\",\"cwd\":\"$j/home/code/app\",\"message\":{\"content\":\"add a login page\"}}"
    echo "{\"type\":\"assistant\",\"timestamp\":\"$now\",\"cwd\":\"$j/home/code/app\",\"message\":{\"content\":[{\"type\":\"text\",\"text\":\"Added the login page.\"}]}}"
    echo "{\"type\":\"user\",\"timestamp\":\"$yesterday\",\"cwd\":\"$j/home/code/app\",\"message\":{\"content\":\"from yesterday\"}}"
    echo "{\"type\":\"user\",\"timestamp\":\"$now\",\"cwd\":\"$j/home/code/app\",\"message\":{\"content\":\"<system-reminder>noise\"}}"
  } >"$j/claude/projects/p/a.jsonl"
  echo "{\"type\":\"user\",\"timestamp\":\"$now\",\"cwd\":\"$j/home/.local/state/cradle/journal\",\"message\":{\"content\":\"the evening run\"}}" \
    >"$j/claude/projects/p/b.jsonl"
  echo "{\"type\":\"user\",\"timestamp\":\"$now\",\"cwd\":\"$j/home/code/mine\",\"message\":{\"content\":\"a personal thing\"}}" \
    >"$j/claude/projects/p/c.jsonl"
  git -C "$j/home/code/mine" init -q
  git -C "$j/home/code/mine" -c user.email=personal@example.com -c user.name=Me -c commit.gpgsign=false \
    commit -q --allow-empty -m "feat: personal commit"
  git -C "$j/home/code/mine" config user.email personal@example.com
  mkdir -p "$j/home/notes/.obsidian"
  git -C "$j/home/notes" init -q
  git -C "$j/home/notes" -c user.email=work@example.com -c user.name=Me -c commit.gpgsign=false \
    commit -q --allow-empty -m "Vault backup now"
  git -C "$j/home/notes" config user.email work@example.com
  git -C "$j/home/code/app" init -q
  git -C "$j/home/code/app" -c user.email=work@example.com -c user.name=Me -c commit.gpgsign=false \
    commit -q --allow-empty -m "feat: login page"
  git -C "$j/home/code/app" config user.email work@example.com
  out=$(HOME=$j/home CLAUDE_CONFIG_DIR=$j/claude XDG_STATE_HOME=$j/home/.local/state \
    "$home/.local/bin/journal-data" "$today") || return 1
  if ! grep -q '^user: add a login page$' <<<"$out" ||
    ! grep -q '^claude: Added the login page.$' <<<"$out" ||
    ! grep -q ' feat: login page$' <<<"$out" ||
    grep -qe 'from yesterday' -e 'noise' -e 'evening run' -e 'personal' -e 'Vault backup' <<<"$out"; then
    echo "$out"
    return 1
  fi
}
vault_sync() { # clone, first backup, rebase onto another machine, conflicts, empty folder
  local stub=$tmp/stub other=$tmp/other-machine sync=$home/.local/bin/vault-sync
  mkdir -p "$stub" "$remotes"
  printf '#!/bin/sh\necho "$@" >>"%s/notified"\n' "$tmp" >"$stub/osascript"
  chmod +x "$stub/osascript"
  printf '[user]\n  name = Me\n  email = me@example.com\n[commit]\n  gpgsign = false\n[init]\n  defaultBranch = master\n' >"$tmp/vault.gitconfig"
  run() { GIT_CONFIG_GLOBAL=$tmp/vault.gitconfig GIT_CONFIG_NOSYSTEM=1 PATH="$stub:$PATH" "$sync" >/dev/null 2>&1; }
  git init -q --bare -b main "$remotes/work.git"
  git init -q --bare -b main "$remotes/personal.git"
  rm -rf "$pvault"
  mkdir -p "$vault/.obsidian"
  echo '{}' >"$vault/.obsidian/workspace.json"
  echo note >"$vault/a.md"
  run || { echo "first run failed"; return 1; }
  git -C "$remotes/work.git" cat-file -e main:a.md || { echo "work vault not backed up"; return 1; }
  ! git -C "$remotes/work.git" cat-file -e main:.obsidian/workspace.json 2>/dev/null ||
    { echo "workspace.json backed up"; return 1; }
  [[ -d $pvault/.git ]] || { echo "personal vault not cloned"; return 1; }
  echo one >"$pvault/note.md"
  { run && git -C "$remotes/personal.git" cat-file -e main:note.md; } || { echo "personal vault not backed up"; return 1; }
  # Another machine pushes; this one rebases onto it.
  GIT_CONFIG_GLOBAL=$tmp/vault.gitconfig git clone -q "$remotes/personal.git" "$other"
  echo theirs >"$other/theirs.md"
  git -C "$other" add -A && GIT_CONFIG_GLOBAL=$tmp/vault.gitconfig git -C "$other" commit -q -m theirs && git -C "$other" push -q
  echo mine >"$pvault/mine.md"
  run || { echo "rebase run failed"; return 1; }
  { [[ -f $pvault/theirs.md ]] && git -C "$remotes/personal.git" cat-file -e main:mine.md; } ||
    { echo "didn't merge the other machine's changes"; return 1; }
  # Both change the same line: stop, keep this machine's notes, notify.
  git -C "$other" pull -q
  echo two >"$other/note.md"
  git -C "$other" add -A && GIT_CONFIG_GLOBAL=$tmp/vault.gitconfig git -C "$other" commit -q -m two && git -C "$other" push -q
  echo three >"$pvault/note.md"
  ! run || { echo "a conflict didn't fail"; return 1; }
  [[ $(cat "$pvault/note.md") == three && ! -d $pvault/.git/rebase-merge ]] ||
    { echo "the conflict changed the vault"; return 1; }
  grep -q 'Vault backup failed' "$tmp/notified" || { echo "no notification"; return 1; }
  # An empty folder (a new machine) takes the repo's notes.
  rm -rf "$pvault" && mkdir -p "$pvault"
  { run && [[ $(cat "$pvault/note.md") == two ]]; } || { echo "empty folder not filled"; return 1; }
}
evening_run() { # the journal (only when there's work to journal), then the backup
  local e=$tmp/evening log=$tmp/evening/order
  mkdir -p "$e/.local/bin" "$e/.local/share/mise/shims"
  [[ ! -e $home/Library/LaunchAgents/local.vault-sync.plist ]] ||
    { echo "its own vault-sync agent beside the journal's"; return 1; }
  # The stubs expand $2 and $WORK when they run, not here.
  # shellcheck disable=SC2016
  printf '#!/bin/sh\necho claude "$2" >>"%s"\n' "$log" >"$e/.local/share/mise/shims/claude"
  printf '#!/bin/sh\necho vault-sync >>"%s"\n' "$log" >"$e/.local/bin/vault-sync"
  # shellcheck disable=SC2016
  printf '#!/bin/sh\n[ -n "$WORK" ] && echo "## ~/code"\nexit 0\n' >"$e/.local/bin/journal-data"
  chmod +x "$e"/.local/bin/* "$e/.local/share/mise/shims/claude"
  HOME=$e XDG_STATE_HOME=$e/state "$home/.local/bin/obsidian-journal" >/dev/null || return 1
  [[ $(cat "$log") == vault-sync ]] || { echo "quiet day:"; cat "$log"; return 1; }
  rm "$log"
  HOME=$e XDG_STATE_HOME=$e/state WORK=1 "$home/.local/bin/obsidian-journal" >/dev/null || return 1
  [[ $(head -1 "$log") == claude*"Don't run vault-sync"* && $(sed -n 2p "$log") == vault-sync ]] ||
    { echo "work day:"; cat "$log"; return 1; }
}
ssh_host() { # ssh_host <ssh config> <alias> <expected hostname>
  local got
  got=$(ssh -G -F "$1" "$2" | sed -n 's/^hostname //p')
  [[ $got == "$3" ]] || { echo "expected $3, got: $got"; return 1; }
}
own_identity() { # this repo's commits use the personal identity
  local want got
  want=$(chezmoi execute-template '{{ .personalEmail }}' 2>/dev/null)
  got=$(git -C "$repo" config user.email)
  [[ $got == "$want" ]] || { echo "cradle commits as '$got', not the personal '$want'"; return 1; }
}
hooks_enabled() {
  [[ $(git -C "$repo" config core.hooksPath) == .githooks ]] ||
    { echo "the commit-msg hook is off; run: git config core.hooksPath .githooks"; return 1; }
}
commit_messages() { # every commit passes the commit-msg hook
  local sha out bad=0
  while read -r sha; do
    git -C "$repo" log -1 --format=%B "$sha" >"$tmp/msg"
    out=$("$repo/.githooks/commit-msg" "$tmp/msg" 2>&1) || { echo "${sha:0:7} $out"; bad=1; }
  done < <(git -C "$repo" rev-list HEAD)
  return "$bad"
}
signed_commits() { # looks for the signature itself; verifying needs allowed_signers
  local sha bad=0
  while read -r sha; do
    git -C "$repo" cat-file commit "$sha" | grep -q '^gpgsig' ||
      { echo "unsigned: $(git -C "$repo" log -1 --format='%h %s' "$sha")"; bad=1; }
  done < <(git -C "$repo" rev-list HEAD)
  return "$bad"
}
release_tags() { # every tag is an annotated, signed vMAJOR.MINOR.PATCH
  local tag type bad=0
  while read -r tag type; do
    [[ $tag =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] ||
      { echo "$tag: not vMAJOR.MINOR.PATCH"; bad=1; }
    if [[ $type != tag ]]; then
      echo "$tag: a lightweight tag; releases are annotated"
      bad=1
    elif ! git -C "$repo" cat-file tag "$tag" | grep -q 'BEGIN SSH SIGNATURE'; then
      echo "$tag: not signed"
      bad=1
    fi
  done < <(git -C "$repo" for-each-ref refs/tags --format='%(refname:short) %(objecttype)')
  return "$bad"
}
nvim_start() {
  local out
  out=$(XDG_CONFIG_HOME=$home/.config XDG_DATA_HOME=$HOME/.local/share \
    XDG_STATE_HOME=$tmp/state XDG_CACHE_HOME=$tmp/cache nvim --headless +qall 2>&1)
  [[ -z $out ]] || { echo "$out"; return 1; }
}

