{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "theme": "auto",
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "enabledPlugins": {},
  "permissions": {
    "ask": [
      "Bash(chezmoi apply *)",
      "Bash(chezmoi update *)",
      "Bash(chezmoi init *)",
      "Bash(chezmoi destroy *)",
      "Bash(chezmoi purge *)"
    ]
  }
}
