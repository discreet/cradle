#!/usr/bin/env bash
# Installs the Brewfile, rendered for this machine. The rendered Brewfile is
# part of this script, so it re-runs whenever that changes (the file or the
# terminal answer).
set -euo pipefail

eval "$(/opt/homebrew/bin/brew shellenv)"
brew bundle --file=- <<'BREWFILE'
{{ includeTemplate "Brewfile.tmpl" . }}
BREWFILE
