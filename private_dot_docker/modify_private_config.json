{{- /* chezmoi:modify-template */ -}}
{{- /*
  docker and colima also write this file (logins, currentContext). Merge the
  keys declared in .chezmoitemplates/docker-config.json over whatever is live,
  so declared values win and runtime additions survive.
*/ -}}
{{- $live := dict -}}
{{- if .chezmoi.stdin | trim -}}
{{-   $live = .chezmoi.stdin | fromJson -}}
{{- end -}}
{{- $managed := includeTemplate "docker-config.json" . | fromJson -}}
{{- mergeOverwrite $live $managed | toPrettyJson "  " }}
